// Reports project API: reads/writes the SAME Supabase table (app_state) used by the main cards project.
const BASE = (process.env.APP_STATE_SUPABASE_URL || "https://nlhjibxhxzwehlzlixgb.supabase.co").replace(/\/+$/, "");
const KEY = process.env.APP_STATE_SUPABASE_KEY || "sb_publishable_iiqsJZG2MfcrPNCpt8iiQA_kfDlzxd1";
const TABLE = "app_state";
const REQ_KEY = "wadi_degla_requests_final";           // ظ‚ط±ط§ط،ط© ظپظ‚ط· â€” ط§ظ„ط·ظ„ط¨ط§طھ ط¨طھطھط¹ظ…ظ„ ظ…ظ† ط§ظ„ظ…ط´ط±ظˆط¹ ط§ظ„ط£طµظ„ظٹ
const MANUAL_KEY = "wadi_degla_manual_card_reports";
const READ_KEYS = [REQ_KEY, "wadi_degla_branches", MANUAL_KEY, "wd_o1_ribbon", "wd_o1_members"];
const WRITE_KEYS = READ_KEYS.filter((k) => k !== REQ_KEY);

function headers(extra) {
  const h = { apikey: KEY, "Content-Type": "application/json" };
  if (!KEY.startsWith("sb_")) h.Authorization = "Bearer " + KEY;
  return Object.assign(h, extra || {});
}
async function sb(path, opts) {
  const r = await fetch(BASE + "/rest/v1/" + path, opts);
  const t = await r.text();
  let j = null;
  try { j = t ? JSON.parse(t) : null; } catch (e) {}
  if (!r.ok) throw new Error((j && (j.message || j.hint || j.error)) || "supabase " + r.status);
  return j;
}

module.exports = async (req, res) => {
  res.setHeader("Cache-Control", "no-store");
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type, x-pin");
  if (req.method === "OPTIONS") return res.status(204).end();
  const pin = process.env.SYNC_PIN;
  if (pin && req.headers["x-pin"] !== pin) return res.status(401).json({ error: "pin" });
  try {
    if (req.method === "GET") {
      const rows = (await sb(TABLE + "?select=key,data&key=in.(" + READ_KEYS.join(",") + ")", { headers: headers() })) || [];
      const o = {};
      rows.forEach((r) => {
        let d = r.data;
        if (r.key === MANUAL_KEY && Array.isArray(d)) d = d.filter((m) => String((m && m.id) || "").indexOf("SEED-") !== 0);
        if (d != null) o[r.key] = JSON.stringify(d);
      });
      return res.status(200).json(o);
    }
    if (req.method === "POST") {
      const b = typeof req.body === "string" ? JSON.parse(req.body) : req.body || {};
      const rows = [];
      WRITE_KEYS.forEach((k) => {
        if (typeof b[k] !== "string") return;
        let d;
        try { d = JSON.parse(b[k]); } catch (e) { return; }
        if (k === MANUAL_KEY && Array.isArray(d)) d = d.filter((m) => String((m && m.id) || "").indexOf("SEED-") !== 0);
        rows.push({ key: k, data: d, writer: "reports", updated_at: new Date().toISOString() });
      });
      if (rows.length) {
        await sb(TABLE + "?on_conflict=key", { method: "POST", headers: headers({ Prefer: "resolution=merge-duplicates,return=minimal" }), body: JSON.stringify(rows) });
      }
      return res.status(200).json({ ok: true });
    }
    return res.status(405).json({ error: "method" });
  } catch (e) {
    return res.status(500).json({ error: String(e.message || e) });
  }
};
